# Copy to .env.local for local dev.
# NEXT_PUBLIC_* is exposed to the browser; other vars are server-only.

/**
 * Backend API base URL, without trailing slash.
 * Used by client components (streaming, uploads) and as SSR fallback when API_URL is unset.
 * The backend listens on $PORT, 5000 unless set — locally, in Docker and on Railway alike.
 * @default http://localhost:5000
 */
NEXT_PUBLIC_API_URL=http://localhost:5000

/**
 * Server-only API URL for SSR, sitemap, and robots.
 * Use when the frontend reaches the backend over a private URL in production.
 * Resolution: API_URL → NEXT_PUBLIC_API_URL → http://localhost:5000
 * @optional
 */
API_URL=

/**
 * Canonical public site origin for sitemap.xml and robots.txt.
 * @default http://localhost:3000 (or https://$VERCEL_URL on Vercel)
 * @optional
 */
NEXT_PUBLIC_SITE_URL=http://localhost:3000

/**
 * Password required for mutating UI actions (upload session, save metadata, file upload).
 * Verified server-side. Leave empty to disable.
 * @optional
 */
ACTION_PASSWORD=
