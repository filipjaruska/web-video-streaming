# ASP.NET Core env vars override appsettings.json. Nested keys use __ (e.g. Storage__RootPath).
# Local: export in shell, launchSettings.json, or IDE env-file support. Railway: service Variables tab.

/**
 * Kestrel listen port.
 * Railway injects this in production. Program.cs binds it for local dotnet run too, whatever launchSettings says.
 * @default 5000
 */
PORT=5000

/**
 * ASP.NET Core environment (logging, exception pages, forwarded headers).
 * @default Production
 */
ASPNETCORE_ENVIRONMENT=Development

/**
 * Root path for uploaded videos, transcodes, and thumbnails.
 * Relative paths resolve from the app content root. VIDEO_STORAGE_ROOT takes precedence over Storage__RootPath.
 * @default App_Data/media
 * @optional
 */
VIDEO_STORAGE_ROOT=

/**
 * appsettings-style storage override. Ignored when VIDEO_STORAGE_ROOT is set.
 * @optional
 */
Storage__RootPath=

/**
 * SQLite connection string for upload session metadata.
 * @default Data Source=App_Data/app.db
 * @optional
 */
ConnectionStrings__DefaultConnection=Data Source=App_Data/app.db

/**
 * CORS allowed origin (index 0). Add production frontend URL; defaults in appsettings include localhost:3000.
 * @optional
 */
AllowedOrigins__0=http://localhost:3000

/**
 * Minutes before an upload session in AwaitingUpload status expires.
 * @default 120
 * @optional
 */
UploadSessions__AwaitingUploadTtlMinutes=120


/**
 * Password required (header X-Action-Password) on every endpoint that changes data, and on the
 * database download. Set it to the frontend's ACTION_PASSWORD in production; empty leaves the API
 * open, which is the default for local development.
 * @optional
 */
ACTION_PASSWORD=

/**
 * Frontend origin whose /api/revalidate is called after every database write, so its caches expire
 * exactly when the data changes.
 * @default AllowedOrigins__0
 * @optional
 */
FRONTEND_URL=

/**
 * Shared secret for that call, sent as a bearer token. Set it to the frontend's REVALIDATE_SECRET in
 * production; empty sends none, which the frontend accepts only while its own is empty too.
 * @optional
 */
REVALIDATE_SECRET=